<%- include("partials/head", { title: "Shto veten — " + siteName }) %>
<%- include("partials/header") %>

<main class="wrap">
  <% if (submitted) { %>
    <div class="success-box">
      <div class="icon">✅</div>
      <h1>U regjistrua!</h1>
      <p>Tani jeni në listën e "<%= category.label %>" për <%= city.label %>. Faleminderit që kontribuoni!</p>
      <a class="btn" href="/qyteti/<%= city.slug %>/kategoria/<%= category.slug %>">Shiko listën</a>
    </div>
  <% } else { %>
    <a class="back-link" href="/">&larr; Kthehu</a>
    <div class="section-title">
      <h1>Shto veten në listë</h1>
    </div>

    <% if (error) { %>
      <div class="error-box" style="max-width:480px;margin:0 auto 0;"><%= error %></div>
    <% } %>

    <form class="add-form" method="post" action="/shto">
      <label>
        Qyteti
        <select name="city" required>
          <option value="" disabled <%= !values.city ? "selected" : "" %>>Zgjidh qytetin</option>
          <% cities.forEach(function(city) { %>
            <option value="<%= city.slug %>" <%= values.city === city.slug ? "selected" : "" %>>
              <%= city.label %>
            </option>
          <% }) %>
        </select>
      </label>

      <label>
        Zanati
        <select name="category" required>
          <option value="" disabled <%= !values.category ? "selected" : "" %>>Zgjidh zanatin</option>
          <% categories.forEach(function(cat) { %>
            <option value="<%= cat.slug %>" <%= values.category === cat.slug ? "selected" : "" %>>
              <%= cat.icon %> <%= cat.label %>
            </option>
          <% }) %>
        </select>
      </label>

      <label>
        Emri e mbiemri
        <input type="text" name="name" required maxlength="80" value="<%= values.name || '' %>" placeholder="p.sh. Agim Krasniqi" />
      </label>

      <label>
        Numri i telefonit
        <input type="tel" name="phone" required maxlength="30" value="<%= values.phone || '' %>" placeholder="p.sh. 069 123 456" />
        <span class="hint">Do të shfaqet publikisht që njerëzit t'ju thërrasin.</span>
      </label>

      <label>
        Shënim shtesë (opsionale)
        <input type="text" name="note" maxlength="200" value="<%= values.note || '' %>" placeholder="p.sh. 15 vjet përvojë, punon edhe të dielave" />
      </label>

      <!-- honeypot, left empty by real visitors -->
      <label class="honey" aria-hidden="true">
        Website
        <input type="text" name="website" tabindex="-1" autocomplete="off" />
      </label>

      <button type="submit">Regjistrohu</button>
    </form>
  <% } %>
</main>

<%- include("partials/footer") %>
