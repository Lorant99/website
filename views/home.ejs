<%- include("partials/head", { title: siteName }) %>
<%- include("partials/header") %>

<main class="wrap">
  <section class="hero">
    <h1><%= siteName %></h1>
    <p class="lead">
      Zgjidh qytetin tënd që të gjesh elektricist, hidraulik, pllakaxhi, kopshtar, pastrues/e
      dhe zanate të tjera lokale. Kur diaspora vjen në shtëpi dhe ka nevojë për dikë, ta dijë kë të thërrasë.
    </p>
  </section>

  <div class="cat-grid">
    <% cities.forEach(function(city) { %>
      <a class="cat-card" href="/qyteti/<%= city.slug %>">
        <span class="icon">📍</span>
        <span class="label"><%= city.label %></span>
        <span class="count"><%= counts[city.slug] || 0 %> të regjistruar</span>
      </a>
    <% }) %>
  </div>
</main>

<%- include("partials/footer") %>
