<%- include("partials/head", { title: category.label + " në " + city.label + " — " + siteName }) %>
<%- include("partials/header") %>

<main class="wrap">
  <a class="back-link" href="/qyteti/<%= city.slug %>">&larr; <%= city.label %> — të gjitha profesionet</a>

  <div class="section-title">
    <h1><%= category.icon %> <%= category.label %> — <%= city.label %></h1>
    <a class="btn" href="/shto?qyteti=<%= city.slug %>&kategoria=<%= category.slug %>">+ Shto veten këtu</a>
  </div>

  <% if (listings.length === 0) { %>
    <div class="empty-state">
      <p>Ende s'ka të regjistruar në <%= category.label.toLowerCase() %> për <%= city.label %>. Bëhu i pari!</p>
      <a class="btn" href="/shto?qyteti=<%= city.slug %>&kategoria=<%= category.slug %>">+ Shto veten</a>
    </div>
  <% } else { %>
    <div class="listing-grid">
      <% listings.forEach(function(l) { %>
        <div class="listing-card">
          <div class="who">
            <div class="name"><%= l.name %></div>
            <div class="city"><%= city.label %></div>
            <% if (l.note) { %><div class="note"><%= l.note %></div><% } %>
          </div>
          <a class="btn call" href="tel:<%= l.phone.replace(/\s+/g, '') %>">📞 <%= l.phone %></a>
        </div>
      <% }) %>
    </div>
  <% } %>
</main>

<%- include("partials/footer") %>
